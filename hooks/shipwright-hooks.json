{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-code-laws.js\" SessionStart",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\inject-code-laws.js\" SessionStart }",
            "timeout": 5,
            "statusMessage": "Loading shipwright code laws..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dotnet/inject-dotnet-skills.js\" SessionStart",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\dotnet\\inject-dotnet-skills.js\" SessionStart }",
            "timeout": 5,
            "statusMessage": "Checking for .NET skills..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-packs/inject-skill-packs.js\" SessionStart",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\skill-packs\\inject-skill-packs.js\" SessionStart }",
            "timeout": 5,
            "statusMessage": "Matching skill packs..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-code-laws.js\" SubagentStart",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\inject-code-laws.js\" SubagentStart }",
            "timeout": 5,
            "statusMessage": "Loading shipwright code laws..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dotnet/inject-dotnet-skills.js\" SubagentStart",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\dotnet\\inject-dotnet-skills.js\" SubagentStart }",
            "timeout": 5,
            "statusMessage": "Checking for .NET skills..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-packs/inject-skill-packs.js\" SubagentStart",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\skill-packs\\inject-skill-packs.js\" SubagentStart }",
            "timeout": 5,
            "statusMessage": "Matching skill packs..."
          }
        ]
      }
    ]
  }
}
